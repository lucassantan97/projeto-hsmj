/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model where all
 * data is partitioned by user. Each user can only access and manage their own
 * data, ensuring strong multi-tenancy and preventing data leakage between users.
 *
 * Data Structure: All application data is nested under the top-level `/users/{userId}`
 * collection, where `{userId}` corresponds to the Firebase Authentication UID. This
 * creates a private data tree for each user, containing their profile, vehicles,
 * maintenance records, and sales history. This structure is inherently secure and
 * simplifies queries.
 *
 * Key Security Decisions:
 * - Default Deny: All access is denied by default. Rules are explicit 'allow'
 *   statements.
 * - User Isolation: Users are strictly forbidden from reading or writing data
 *   outside of their own `/users/{userId}` path. Listing user profiles is disabled.
 * - Authorization Independence: Every document contains a denormalized `ownerUserId`
 *   field. This allows security rules to make fast, efficient authorization
 *   decisions without needing costly `get()` calls to parent documents, which
 *   also supports atomic batch/transaction operations.
 * - Relational Integrity: On document creation, rules validate that the `ownerUserId`
 *   and other ID fields within the document's data match the IDs in the document's
 *   path. On update, these critical relational fields are enforced as immutable to
 *   prevent documents from being moved or reassigned.
 *
 * Prototyping Flexibility: In this prototyping phase, rules focus on *authorization*
 * (who can access what) and not *data validation* (the shape of the data).
 * Schema enforcement is intentionally omitted to allow for rapid iteration on the
 * client-side application.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    /**
     * Returns true if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Returns true if the authenticated user's UID matches the provided userId.
     * This is the cornerstone of the user-ownership model.
     * @param userId The UID of the document owner.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Returns true if the user is the owner and the document already exists.
     * Used for safe update and delete operations.
     * @param userId The UID of the document owner.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the UserProfile being created has an `id` that matches the
     * document's path ID (`userId`).
     * @param userId The `{userId}` from the path.
     */
    function hasValidUserProfileDataOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Enforces immutability of the UserProfile's `id` field during an update.
     */
    function hasImmutableUserProfileDataOnUpdate() {
      return request.resource.data.id == resource.data.id;
    }

    /**
     * Validates that data being created contains the correct owner and path IDs.
     * Ensures relational integrity between the document and its path.
     * @param ownerId The `{userId}` from the path.
     * @param docId The document ID wildcard from the path.
     */
    function hasValidOwnerAndDocId(ownerId, docId) {
      let incomingData = request.resource.data;
      return incomingData.ownerUserId == ownerId && incomingData.id == docId;
    }
    
    /**
     * Enforces immutability of `ownerUserId` and `id` fields during an update.
     */
    function hasImmutableOwnerAndDocId() {
      let incomingData = request.resource.data;
      let existingData = resource.data;
      return incomingData.ownerUserId == existingData.ownerUserId && incomingData.id == existingData.id;
    }

    /**
     * Validates MaintenanceRecord data, which has an extra layer of relational nesting.
     * @param ownerId The `{userId}` from the path.
     * @param vehicleId The parent `{vehicleId}` from the path.
     * @param recordId The `{maintenanceRecordId}` from the path.
     */
    function hasValidMaintenanceRecordData(ownerId, vehicleId, recordId) {
      let incomingData = request.resource.data;
      return incomingData.ownerUserId == ownerId && incomingData.vehicleId == vehicleId && incomingData.id == recordId;
    }
    
    /**
     * Enforces immutability for all relational IDs on a MaintenanceRecord.
     */
    function hasImmutableMaintenanceRecordData() {
        let incomingData = request.resource.data;
        let existingData = resource.data;
        return incomingData.ownerUserId == existingData.ownerUserId && incomingData.vehicleId == existingData.vehicleId && incomingData.id == existingData.id;
    }

    //-------------------------------------------------------------------------
    // User Profiles
    //-------------------------------------------------------------------------

    /**
     * @description Manages a user's own profile document.
     * @path /users/{userId}
     * @allow (create) An authenticated user can create their own user profile document.
     * @deny  (create) A user 'user_abc' tries to create a profile for 'user_xyz'.
     * @principle A user's root document can only be created by the user themselves.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && hasValidUserProfileDataOnCreate(userId);
      allow update: if isExistingOwner(userId) && hasImmutableUserProfileDataOnUpdate();
      allow delete: if isExistingOwner(userId);

      //-----------------------------------------------------------------------
      // Vehicle Groups
      //-----------------------------------------------------------------------

      /**
       * @description A user's collection of vehicle groups.
       * @path /users/{userId}/vehicleGroups/{vehicleGroupId}
       * @allow (create) 'user_abc' creates a new vehicle group in their own collection.
       * @deny  (get) 'user_xyz' tries to read a vehicle group belonging to 'user_abc'.
       * @principle Enforces document ownership within a user's private data tree.
       */
      match /vehicleGroups/{vehicleGroupId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidOwnerAndDocId(userId, vehicleGroupId);
        allow update: if isExistingOwner(userId) && hasImmutableOwnerAndDocId();
        allow delete: if isExistingOwner(userId);
      }

      //-----------------------------------------------------------------------
      // Vehicles
      //-----------------------------------------------------------------------

      /**
       * @description A user's collection of vehicles.
       * @path /users/{userId}/vehicles/{vehicleId}
       * @allow (list) 'user_abc' lists all vehicles in their own collection.
       * @deny  (update) 'user_xyz' tries to modify a vehicle belonging to 'user_abc'.
       * @principle Restricts access to a user's own data tree.
       */
      match /vehicles/{vehicleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidOwnerAndDocId(userId, vehicleId);
        allow update: if isExistingOwner(userId) && hasImmutableOwnerAndDocId();
        allow delete: if isExistingOwner(userId);

        //---------------------------------------------------------------------
        // Maintenance Records
        //---------------------------------------------------------------------

        /**
         * @description Maintenance records for a specific vehicle.
         * @path /users/{userId}/vehicles/{vehicleId}/maintenanceRecords/{maintenanceRecordId}
         * @allow (create) 'user_abc' adds a maintenance record to one of their own vehicles.
         * @deny  (get) An unauthenticated user tries to read any maintenance record.
         * @principle Validates relational integrity between documents and their nested paths.
         */
        match /maintenanceRecords/{maintenanceRecordId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId) && hasValidMaintenanceRecordData(userId, vehicleId, maintenanceRecordId);
          allow update: if isExistingOwner(userId) && hasImmutableMaintenanceRecordData();
          allow delete: if isExistingOwner(userId);
        }
      }

      //-----------------------------------------------------------------------
      // Sales
      //-----------------------------------------------------------------------

      /**
       * @description A user's collection of vehicle sale records.
       * @path /users/{userId}/sales/{saleId}
       * @allow (delete) 'user_abc' deletes a sale record they created.
       * @deny  (create) 'user_xyz' tries to create a sale record under 'user_abc's account.
       * @principle Enforces document ownership and validates relational IDs on creation.
       */
      match /sales/{saleId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && hasValidOwnerAndDocId(userId, saleId);
        allow update: if isExistingOwner(userId) && hasImmutableOwnerAndDocId();
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}